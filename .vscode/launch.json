{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🌐 1. Run Web Workbench & API (FastAPI: http://localhost:8000/ui)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "api.appian_api:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "🏥 2. Run Operations & Committee Portal (Streamlit: http://localhost:8501)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "ui/app.py",
        "--server.port",
        "8501"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "📋 3. Run CLI Batch Roster Process",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_agent.py",
      "args": [
        "--roster",
        "data/sample_provider_roster.csv"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "🧪 4. Run Pytest Test Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_cred_agent.py",
        "-v"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal"
    }
  ]
}
