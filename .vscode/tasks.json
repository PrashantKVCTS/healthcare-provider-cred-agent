{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "📦 Install Dependencies",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "🧪 Run Unit & Integration Tests",
      "type": "shell",
      "command": "python -m pytest tests/test_cred_agent.py -v",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "🌐 Start Web Workbench API (http://localhost:8000/ui)",
      "type": "shell",
      "command": "python -m uvicorn api.appian_api:app --host 0.0.0.0 --port 8000 --reload",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🏥 Start Streamlit Operations Portal (http://localhost:8501)",
      "type": "shell",
      "command": "streamlit run ui/app.py",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
